/// The contract between Horizon and its mods (docs/mods.md).
///
/// A mod is a WebAssembly component targeting the `mod` world. Each imported
/// interface but `log` is a capability: the mod's manifest lists the ones it
/// uses, the player sees them before turning the mod on, and the game refuses
/// a component that imports one its manifest does not declare.
package horizon:mods@0.1.0;

/// The mod's log, in the game's log under the mod's id. Always granted.
interface log {
    enum level {
        debug,
        info,
        warn,
        error,
    }
    /// One line in the game's log as `[mod <id>] message`, at that level.
    write: func(level: level, message: string);
}

/// Capability `game-read`: the local player and the world clock.
interface game {
    record player {
        /// Feet position, in blocks.
        x: f64,
        y: f64,
        z: f64,
        /// Degrees, as F3 shows them.
        yaw: f32,
        /// Degrees: -90 looks straight up, 90 straight down.
        pitch: f32,
        /// Hit points as vanilla counts them: 20 is full health without effects.
        health: f32,
        /// 0 to 20, as the hunger bar.
        food: u32,
        /// `minecraft:overworld`, `minecraft:the_nether`, ...
        dimension: string,
    }
    record clock {
        /// Ticks since the world was created.
        game-time: u64,
        /// 24000 ticks per day; 0 is 6:00 on the first day.
        day-time: u64,
    }
    /// None on the title screen.
    get-player: func() -> option<player>;
    /// None on the title screen.
    get-clock: func() -> option<clock>;
    /// Whether the local player is flying (creative flight, or a spectator), as the game has them this tick; false
    /// on the title screen.
    player-flying: func() -> bool;
}

/// Capability `chat`: messages only the local player sees.
interface chat {
    /// Shown in chat after the mod's name, like a system message.
    show: func(text: string);
}

/// Capability `hud`: one panel of text lines per mod, drawn by the game
/// every frame until the mod changes or clears it (no call per frame).
interface hud {
    enum corner {
        top-left,
        top-right,
        bottom-left,
        bottom-right,
    }
    record line {
        /// Plain text, up to 256 characters.
        text: string,
        /// 0xRRGGBB.
        color: u32,
    }
    /// Replaces the mod's panel: up to 16 lines in that corner of the screen.
    set-panel: func(corner: corner, lines: list<line>);
    /// Removes the mod's panel.
    clear: func();
}

/// Capability `storage`: a per-mod folder of small key/value files, quota'd
/// (docs/mods.md). Keys are `[a-z0-9_.-]{1,64}`, one path segment.
interface storage {
    /// None if `key` has never been `set`, or the key is not well-formed.
    get: func(key: string) -> option<list<u8>>;
    /// Errs on a malformed key or over quota (bytes for the whole mod).
    set: func(key: string, value: list<u8>) -> result<_, string>;
    /// No error if `key` was already absent.
    delete: func(key: string);
}

/// Capability `input`: right-clicks with items the mod claims, keybinds it
/// registers, and clicks and typing on its screen (capability `ui`). Events queue up
/// between calls; the mod collects them with `poll`, usually each tick.
interface input {
    /// An item stack as the mod sees it.
    record held-item {
        /// `minecraft:spyglass`, `mymod:wand`, ...
        id: string,
        count: u32,
        /// 0-8 the hotbar, 40 the offhand.
        slot: u32,
        /// `minecraft:custom_name` as plain text.
        custom-name: option<string>,
        /// `minecraft:custom_data` as SNBT.
        custom-data: option<string>,
    }
    record item-use {
        item: held-item,
        /// Game ticks the button was held (0 on `use-start`).
        ticks: u32,
    }
    record click {
        /// GUI pixels from the centre of the screen (as `ui.show` draws).
        x: f32,
        y: f32,
        /// 0 left, 1 right, 2 middle.
        button: u32,
    }
    variant event {
        /// The use button went down with a claimed item in hand. The game does
        /// nothing else with the click: no zoom, no placing, no swing.
        use-start(item-use),
        /// It came up again (or the player switched slots, or a screen opened).
        use-stop(item-use),
        /// A registered key went down or up while playing (no screen open).
        key-down(string),
        key-up(string),
        /// A click on the mod's screen.
        screen-click(click),
        /// The player closed the mod's screen (Escape).
        screen-closed,
    }
    /// A key pressed on the mod's screen (capability `ui`), held keys
    /// repeating. Escape is the game's: it closes the screen.
    variant typed {
        /// The characters it typed, as a text box takes them (no control
        /// characters).
        text(string),
        /// A key that types nothing (Backspace, Delete, Enter, Tab, the
        /// arrows, Home, End, ...), as options.txt writes keys
        /// (`key.keyboard.backspace`, `key.keyboard.enter`).
        key(string),
    }
    /// Items whose use the mod handles instead of the game, by id. Replaces
    /// the previous list.
    claim-items: func(ids: list<string>);
    /// A keybind, listed in Options > Controls under the mod's name, where
    /// the player can rebind it: `name` is the mod's own (it comes back in
    /// `key-down`), `label` what Controls shows, `key` the default as
    /// options.txt writes keys (`key.keyboard.r`).
    register-key: func(name: string, label: string, key: string);
    /// The stack in the main hand, as of this tick.
    held: func() -> option<held-item>;
    /// The events since the last call, oldest first (at most 256 are kept).
    poll: func() -> list<event>;
    /// What was typed on the mod's screen since the last call, oldest first
    /// (at most 256 are kept; what is left when the screen closes is
    /// dropped). A mod with a text field calls it with `poll`, each tick.
    poll-typed: func() -> list<typed>;
}

/// Capability `ui`: one screen the mod owns. The mod hands the game what to
/// draw; the game draws it every frame, releases the mouse, and sends clicks
/// and Escape back as `input` events. It does not pause the game.
interface ui {
    record rect {
        x: f32,
        y: f32,
        w: f32,
        h: f32,
    }
    record point {
        x: f32,
        y: f32,
    }
    variant draw {
        /// A filled rectangle, colour 0xAARRGGBB.
        fill(tuple<rect, u32>),
        /// Any four-cornered shape (wheel segments, arrows), 0xAARRGGBB.
        quad(tuple<list<point>, u32>),
        /// A GUI sprite (`gui/sprites/...`, or a mod's `gui/...` texture)
        /// stretched over a rectangle, tinted 0xAARRGGBB.
        sprite(tuple<string, rect, u32>),
        /// An item, drawn as the hotbar draws it, at 16 x 16 times `scale`.
        /// The second string is an item model id to use instead (or empty).
        item(tuple<string, string, point, f32>),
        /// Text with a shadow, 0xRRGGBB; centred on `x` when the bool is set.
        text(tuple<string, point, u32, bool>),
    }
    /// Opens the mod's screen (or redraws it): coordinates are GUI pixels
    /// from the screen's centre, drawn in order.
    show: func(draws: list<draw>);
    /// Closes the mod's screen, if it is open (the player's Escape closes it too).
    close: func();
    /// The cursor in GUI pixels from the centre while the screen is open.
    cursor: func() -> option<point>;
}

/// Capability `atlas`: the game's block textures, for the mod's post pass
/// (capability `render`) to draw blocks with, as the world draws them. With
/// it the pass is also given the block sprite arrays, which it declares
/// itself (docs/mods.md, "Block textures in a post pass"):
///     @group(0) @binding(8) var block_sprites: texture_2d_array<f32>;
///     @group(0) @binding(9) var block_sampler: sampler;
/// and, for a content mod's textures past the first 2048 layers, arrays 1
/// to 7 at bindings 10 to 16 (`block_sprites_1` ...). Each texture is a
/// whole layer, square, its UVs 0 to 1 within it; animated ones always hold
/// the frame being shown. The textures are the player's own (their
/// resource packs included): the mod ships none.
interface atlas {
    /// What a face is coloured with, as the game colours the block: the
    /// colour of the biome where it is (grass, foliage, dry foliage, water;
    /// `read-columns` gives them) or a fixed one (0xRRGGBB). Multiply the
    /// texture by it.
    variant tint {
        none,
        grass,
        foliage,
        dry-foliage,
        water,
        fixed(u32),
    }
    /// A texture in the sprite arrays: `array` (0 for every vanilla texture:
    /// binding 8; 1 to 7 at bindings 10 to 16) and its `layer` there.
    record sprite {
        array: u32,
        layer: u32,
        /// It animates (water, lava, fire, ...); the arrays hold its frame.
        animated: bool,
        /// Some of its pixels are clear (alpha 0): leaves, glass, flowers.
        cutout: bool,
    }
    /// One face of a block's model, on one side of the block. A side's two
    /// axes run along x then z for down and up, x then y for north and
    /// south, z then y for west and east, from 0 at the block's corner
    /// nearest 0, 0, 0 to 1.
    record face {
        sprite: sprite,
        /// Where it lies on the side, in the side's axes: a0, b0, a1, b1
        /// (0, 0, 1, 1 for a whole face).
        rect: tuple<f32, f32, f32, f32>,
        /// How far into the block from the side's plane (0 for a cube's
        /// face, 0.5 for the top of a bottom slab).
        inset: f32,
        /// The texture across the side: the point a, b of it shows the
        /// sprite at u = u0 + a * du-u + b * dv-u, v = v0 + a * du-v + b *
        /// dv-v; given as u0, v0, du-u, du-v, dv-u, dv-v. A rotated model
        /// (a log on its side) is rotated here.
        uv: tuple<f32, f32, f32, f32, f32, f32>,
        tint: tint,
        /// Partly clear pixels: drawn blended, as the world draws glass.
        translucent: bool,
    }
    /// What a block draws.
    record block-faces {
        /// Six lists, one a side: down, up, north, south, west, east. Each
        /// holds its faces in the order drawn (a grass block's side: its
        /// dirt and grass, then the grass overlay tinted over it); empty
        /// for a side with none. Faces that don't lie flat on a side (a
        /// flower's crossed planes) are left out: use `particle`.
        sides: list<list<face>>,
        /// The model's particle texture (what breaking it scatters).
        particle: option<sprite>,
        /// A plain cube: a whole face on every side at its plane (and
        /// overlays on them), nothing else.
        cube: bool,
    }
    /// For each name (`minecraft:grass_block`, `oak_log[axis=x]`:
    /// properties left out take the block's default), what its model
    /// draws, as the world draws that state (the first of its random
    /// variants); none for a block the game doesn't know. A fluid has its
    /// still texture on all six sides; a block drawn only as a block entity
    /// (a chest) has none. At most 4,096 names a call; the rest are none.
    /// Resource packs may change the layers: ask again when the game says
    /// the pack changed (`resources-version`).
    block-sprites: func(names: list<string>) -> list<option<block-faces>>;
    /// For each texture name (`minecraft:block/stone`, `block/stone`), its
    /// sprite; none for one the arrays don't hold (they hold the textures
    /// block and item models use). At most 4,096 names a call.
    texture-sprites: func(names: list<string>) -> list<option<sprite>>;
    /// Changes whenever the textures are loaded again (a resource pack
    /// turned on or off): the layers may have moved. 0 until they load.
    resources-version: func() -> u64;
}

/// Capability `render`: a post-processing pass the mod supplies, drawn over
/// the world (under the hand and the HUD), before a shader pack's own
/// post-processing, if any.
interface render {
    /// The pass: a WGSL fragment shader with an `fs_main` entry, after the
    /// mod pass prelude (docs/mods.md, "A mod's post pass": the world's
    /// colour and depth, a `Frame` uniform and helpers). Compiled once per
    /// distinct source; an error is logged and the pass skipped. A pass may
    /// also draw its costly part at half size: `fs_half` and `fs_join`
    /// beside `fs_main` (docs/mods.md, "A half-size stage").
    set-post: func(wgsl: string);
    /// Sixteen floats the pass reads as `frame.mod_params[0..4]`, kept until
    /// changed. The pass runs only while some are set.
    set-params: func(params: list<f32>);
    /// Stops the pass: no source, no parameters and no data until the next
    /// `set-post` and `set-params`.
    clear-post: func();
    /// Words the pass reads as `mod_data` (`var<storage, read> mod_data:
    /// array<u32>`, binding 5 of the prelude; `bitcast<f32>` for floats),
    /// kept until changed or the pass is cleared. Until some are set it
    /// holds one word, 0: read `arrayLength(&mod_data)` before indexing.
    /// Uploaded to the GPU only when they change. At most 262,144 words
    /// (1 MiB) a call; more are ignored (logged).
    set-data: func(words: list<u32>);
    /// Asks for the pass's history (default off, off again by `clear-post`): the game keeps what the pass returned the
    /// frame before and gives it back as `history_picture` (binding 17 of the prelude, which the pass declares itself)
    /// with the previous frame's camera (`frame.previous_view`, `previous_projection`, `previous_camera_position`),
    /// for feedback, trails and temporal reprojection (docs/mods.md, "A history"). Costs one more picture of memory
    /// and a texture read; a pass that declares the binding without asking for it is refused (logged).
    set-history: func(on: bool);
    /// Gives the game a world warp (empty: none): the WGSL `fn world_warp(pos: vec3<f32>, copy: u32) -> Warped`, which
    /// takes the place of the identity every terrain vertex (the far terrain's tiles too) and entity vertex goes through.
    /// `pos` is the vertex from the camera; `Warped` is `{ pos: vec3<f32>, tint: vec3<f32> }`, where to draw it from the
    /// camera and what to multiply its colour by. It reads `globals.warp` (docs/mods.md, "A world warp"). It may be
    /// any function of the position, so the mod can bend the real world, and is built when first turned on. It runs only
    /// while `warp-on` holds it on.
    set-warp: func(wgsl: string);
    /// Turns the world warp on or off (off by default, and when the mod stops). While on, nothing is left out of a
    /// frame by where it was: more is drawn. `copies` (at most 8) draws the solid sections within `radius` blocks of
    /// (x, y, z) that many times more, each with its number (1 up) as the warp's `copy`.
    warp-on: func(on: bool, x: f64, y: f64, z: f64, copies: u32, radius: f32);
    /// Shakes the camera: a jolt of `strength` (0 to 1, 1 the hardest) that
    /// fades out over `seconds` (at most 30). Jolts add up. The game turns
    /// the view (not the player) with smooth noise, scaled by the player's
    /// Distortion Effects option.
    shake: func(strength: f32, seconds: f32);
}

/// Capability `world`: the world around the player, and changes to it.
/// Changes need a world this game runs (single player, or hosting LAN);
/// on a remote server they are ignored and logged.
interface %world {
    record hit {
        /// The block hit and the point on its face.
        block-x: s32,
        block-y: s32,
        block-z: s32,
        x: f64,
        y: f64,
        z: f64,
        /// `minecraft:stone`, ...
        block: string,
    }
    /// The first block along the player's view (fluids pass), up to
    /// `distance` blocks (at most 1024; past the loaded chunks, across the
    /// distant terrain when LOD Distance is on), as of this tick.
    raycast: func(distance: f32) -> option<hit>;
    /// Runs commands as the server would (operator level, no chat feedback),
    /// in order, right after this call returns, all in this tick.
    run-commands: func(commands: list<string>);
    /// A sound event (vanilla's or a resource pack's) at a point, or
    /// following the player when `at` is none.
    play-sound: func(event: string, at: option<tuple<f64, f64, f64>>, volume: f32, pitch: f32);
    /// The local player's flying speed (creative flight), as vanilla's
    /// abilities hold it: 0.05 is vanilla's, sprinting doubles it, at most
    /// 50. The game keeps it until the mod changes it or stops, through
    /// respawns, game mode changes and other worlds; none (or a value that
    /// is not a number) puts vanilla's back. A spectator keeps the scroll
    /// wheel's speed. On a remote server it is ignored and logged.
    set-flying-speed: func(speed: option<f32>);
    /// Adds to the local player's velocity, in blocks a tick (`x`, `y`,
    /// `z`), as an explosion's knockback does: the player is thrown and
    /// falls back under gravity, flying or not, colliding as they move.
    /// Each component is clamped to -4..4 a call; a spectator, or a value
    /// that is not a number, is left alone.
    push-player: func(x: f32, y: f32, z: f32);
    /// Carries the local player this tick: moves them by `x`, `y`, `z`
    /// blocks through the game's own collision move in place of their own
    /// motion (no gravity, no drag, their walking input left out, their
    /// fall distance kept at nothing), drawn smoothly between ticks as a
    /// ride is, and turns their view by `turn` degrees of yaw over the tick
    /// (spread over its frames; clamped to -6..6, 0 to leave it alone).
    /// Each component is clamped to -4..4. Out of creative flight and any
    /// glide while carried; jumping, a double jump or a tap of sneak do
    /// nothing. They break free only by holding sneak for half a second (10
    /// ticks running): that tick they move as their own, and the next call
    /// answers false; they stay free until a tick with no carry asked. Let
    /// go (broken free, or no carry asked the tick after one), they keep
    /// only a little of the carry's motion and, if they may fly and are off
    /// the ground, are put back into creative flight; unless the mod threw
    /// them: a `push-player` while carried is kept as the throw, and the
    /// first tick with no carry asked lets them go with exactly that
    /// velocity, out of flight, their fall distance counted from there.
    /// True while the
    /// carries hold (and on the first call); a spectator, someone riding,
    /// or a value that is not a number is left alone and answers false.
    carry-player: func(x: f32, y: f32, z: f32, turn: f32) -> bool;
    /// Which of a column's heights a run's `y` counts from (vanilla's
    /// heightmaps): one above the highest block that is not air, that blocks
    /// motion or holds a fluid, that does so and is not leaves, or that is
    /// solid.
    enum heightmap {
        world-surface,
        motion-blocking,
        motion-blocking-no-leaves,
        ocean-floor,
    }
    /// A run of blocks up one column: `height` blocks from `y` up, set to
    /// palette entry `block`.
    record block-run {
        x: s32,
        z: s32,
        /// The lowest block it changes: a height in the world, or with
        /// `surface` the blocks over (under, when negative) the column's
        /// height on that heightmap.
        y: s32,
        height: u32,
        surface: option<heightmap>,
        /// An index into the edit's `palette`.
        block: u32,
        /// An index into the edit's `filters`: only the blocks that match
        /// it change. None changes every block of the run.
        only: option<u32>,
    }
    /// Block changes made at once, straight into the world's chunk sections
    /// (see `edit-blocks`).
    record block-edit {
        /// The block states the runs set, as commands write them:
        /// `minecraft:stone`, `minecraft:oak_log[axis=x]`.
        palette: list<string>,
        /// What a run may require of the block it replaces, as `fill ...
        /// replace` takes it: `minecraft:air`, `#minecraft:logs`.
        filters: list<string>,
        /// Made in order, each seeing the changes of those before it.
        runs: list<block-run>,
    }
    /// Sets many blocks at once, far faster than `fill` and `setblock`: a
    /// run per span of a column, each block its own palette entry if need
    /// be. Made on the world's thread right after this call returns, in
    /// order with `run-commands`, as `fill ... strict` makes them: nothing
    /// round them is told (no neighbour or shape updates, no drops, sand and
    /// gravel stay up, water and lava keep still), and a block entity goes
    /// with its block. Light is worked out again once for each chunk
    /// changed, off the world's thread, each chunk is remeshed once, and the
    /// players who see a chunk are sent it whole. Heights (`surface`) are read
    /// before any of the edit's changes. Only loaded chunks change, within
    /// the world's height; the rest of a run is left out. At most 1,048,576
    /// runs and 4,096 palette entries and filters a call. A block or filter
    /// that does not parse, or an index past the end, leaves the whole edit
    /// out (logged). On a remote server it is ignored and logged.
    edit-blocks: func(edit: block-edit);
    /// The answer to a `surface-height` query: its `tag`, and for each of
    /// its columns, in order, the height asked for (one above the highest
    /// block that counts on that heightmap, as `edit-blocks` reads it), or
    /// none where the column's chunk is not loaded.
    record surface-heights {
        tag: u32,
        heights: list<option<s32>>,
    }
    /// Asks the world for the height of each of `columns` (x, z) on
    /// `heightmap`. The world is read where `edit-blocks` changes it, on its
    /// own thread, in order with `run-commands` and `edit-blocks` (a query
    /// made after an edit sees it), and the answer comes back through
    /// `poll-surface-heights`, with the `tag` given here: a tick or two later
    /// in single player (the world answers between two of its ticks; the mod
    /// never waits on it). Chunks a mod keeps loaded (`forceload`) are read
    /// as any other. At most 65,536 columns a call; a query with more is left
    /// out (logged). On a remote server every height is none, answered at
    /// once.
    surface-height: func(tag: u32, columns: list<tuple<s32, s32>>, heightmap: heightmap);
    /// The answers to `surface-height` queries that came back since the
    /// last call, oldest first.
    poll-surface-heights: func() -> list<surface-heights>;
    /// The answer to a `read-columns` query: its `tag`; the names of the
    /// blocks it saw (`minecraft:snow`, without their properties), which
    /// `blocks` index; for each of its columns, in order, the height it
    /// counted from (as `surface-height` answers it), or none where the
    /// column's chunk is not loaded; and each column's blocks, `below` +
    /// `above` of them a column, bottom first: from `below` under that
    /// height up to `above` - 1 over it (a column that is not loaded, and
    /// what is outside the world's height, reads as air); and each column's
    /// biome tints, three a column: the grass's, the foliage's and the
    /// water's colour there (0xRRGGBB, as the game tints its blocks; 0 where
    /// the column is not loaded).
    record column-blocks {
        tag: u32,
        palette: list<string>,
        bases: list<option<s32>>,
        blocks: list<u16>,
        tints: list<u32>,
    }
    /// Asks the world for the blocks of each of `columns` (x, z) round its
    /// height on `heightmap`: `below` blocks under it and `above` from it
    /// up. Read and answered as `surface-height` is, in order with
    /// `run-commands` and `edit-blocks`, through `poll-columns` with the
    /// `tag` given here, a tick or two later in single player. At most
    /// 65,536 columns, 64 blocks a column and 1,048,576 blocks a call; a
    /// query with more is left out (logged). On a remote server every
    /// column is none, answered at once.
    read-columns: func(tag: u32, columns: list<tuple<s32, s32>>, heightmap: heightmap, below: u32, above: u32);
    /// The answers to `read-columns` queries that came back since the last
    /// call, oldest first.
    poll-columns: func() -> list<column-blocks>;
}

/// What the game calls. Only the hooks `init` asks for are ever called.
interface events {
    record registration {
        /// Chat commands, without the slash. A name vanilla already uses is
        /// refused (vanilla's command runs).
        commands: list<string>,
        /// Call `tick` every game tick (20 per second while playing).
        tick: bool,
        /// Call `frame` every rendered frame. Budget: 0.1 ms.
        frame: bool,
        /// Call `chat` for each chat line the player receives.
        chat: bool,
    }
    /// Once, after loading. An error keeps the mod off and is shown.
    init: func() -> result<registration, string>;
    /// Each game tick while in a world, with the game's tick counter.
    tick: func(tick: u64);
    /// Each rendered frame, with the seconds since the last one.
    frame: func(seconds: f32);
    /// `/name args`: ok(some(text)) is shown as feedback, err(text) in red.
    command: func(name: string, args: string) -> result<option<string>, string>;
    /// Each chat line the player receives, as plain text.
    chat: func(text: string);
}

world horizon-mod {
    import log;
    import game;
    import chat;
    import hud;
    import storage;
    import input;
    import ui;
    import render;
    import %world;
    import atlas;
    export events;
}

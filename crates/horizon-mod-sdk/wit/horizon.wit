/// The contract between Horizon and its mods (docs/mods.md).
///
/// A mod is a WebAssembly component targeting the `mod` world. Each imported
/// interface but `log` is a capability: the mod's manifest lists the ones it
/// uses, the player sees them before turning the mod on, and the game refuses
/// a component that imports one its manifest does not declare.
package horizon:mods@0.1.0;

/// The mod's log, in the game's log under the mod's id. Always granted.
interface log {
    enum level {
        debug,
        info,
        warn,
        error,
    }
    write: func(level: level, message: string);
}

/// Capability `game-read`: the local player and the world clock.
interface game {
    record player {
        x: f64,
        y: f64,
        z: f64,
        /// Degrees, as F3 shows them.
        yaw: f32,
        pitch: f32,
        health: f32,
        food: u32,
        /// `minecraft:overworld`, `minecraft:the_nether`, ...
        dimension: string,
    }
    record clock {
        /// Ticks since the world was created.
        game-time: u64,
        /// 24000 ticks per day; 0 is 6:00 on the first day.
        day-time: u64,
    }
    /// None on the title screen.
    get-player: func() -> option<player>;
    get-clock: func() -> option<clock>;
}

/// Capability `chat`: messages only the local player sees.
interface chat {
    /// Shown in chat after the mod's name, like a system message.
    show: func(text: string);
}

/// Capability `hud`: one panel of text lines per mod, drawn by the game
/// every frame until the mod changes or clears it (no call per frame).
interface hud {
    enum corner {
        top-left,
        top-right,
        bottom-left,
        bottom-right,
    }
    record line {
        text: string,
        /// 0xRRGGBB.
        color: u32,
    }
    set-panel: func(corner: corner, lines: list<line>);
    clear: func();
}

/// Capability `storage`: a per-mod folder of small key/value files, quota'd
/// (docs/mods.md). Keys are `[a-z0-9_.-]{1,64}`, one path segment.
interface storage {
    /// None if `key` has never been `set`, or the key is not well-formed.
    get: func(key: string) -> option<list<u8>>;
    /// Errs on a malformed key or over quota (bytes for the whole mod).
    set: func(key: string, value: list<u8>) -> result<_, string>;
    /// No error if `key` was already absent.
    delete: func(key: string);
}

/// Capability `input`: right-clicks with items the mod claims, keybinds it
/// registers, and clicks on its screen (capability `ui`). Events queue up
/// between calls; the mod collects them with `poll`, usually each tick.
interface input {
    /// An item stack as the mod sees it.
    record held-item {
        /// `minecraft:spyglass`, `mymod:wand`, ...
        id: string,
        count: u32,
        /// 0-8 the hotbar, 40 the offhand.
        slot: u32,
        /// `minecraft:custom_name` as plain text.
        custom-name: option<string>,
        /// `minecraft:custom_data` as SNBT.
        custom-data: option<string>,
    }
    record item-use {
        item: held-item,
        /// Game ticks the button was held (0 on `use-start`).
        ticks: u32,
    }
    record click {
        /// GUI pixels from the centre of the screen (as `ui.show` draws).
        x: f32,
        y: f32,
        /// 0 left, 1 right, 2 middle.
        button: u32,
    }
    variant event {
        /// The use button went down with a claimed item in hand. The game does
        /// nothing else with the click: no zoom, no placing, no swing.
        use-start(item-use),
        /// It came up again (or the player switched slots, or a screen opened).
        use-stop(item-use),
        /// A registered key went down or up while playing (no screen open).
        key-down(string),
        key-up(string),
        /// A click on the mod's screen.
        screen-click(click),
        /// The player closed the mod's screen (Escape).
        screen-closed,
    }
    /// Items whose use the mod handles instead of the game, by id. Replaces
    /// the previous list.
    claim-items: func(ids: list<string>);
    /// A keybind, listed in Options > Controls under the mod's name, where
    /// the player can rebind it: `name` is the mod's own (it comes back in
    /// `key-down`), `label` what Controls shows, `key` the default as
    /// options.txt writes keys (`key.keyboard.r`).
    register-key: func(name: string, label: string, key: string);
    /// The stack in the main hand, as of this tick.
    held: func() -> option<held-item>;
    /// The events since the last call, oldest first (at most 256 are kept).
    poll: func() -> list<event>;
}

/// Capability `ui`: one screen the mod owns. The mod hands the game what to
/// draw; the game draws it every frame, releases the mouse, and sends clicks
/// and Escape back as `input` events. It does not pause the game.
interface ui {
    record rect {
        x: f32,
        y: f32,
        w: f32,
        h: f32,
    }
    record point {
        x: f32,
        y: f32,
    }
    variant draw {
        /// A filled rectangle, colour 0xAARRGGBB.
        fill(tuple<rect, u32>),
        /// Any four-cornered shape (wheel segments, arrows), 0xAARRGGBB.
        quad(tuple<list<point>, u32>),
        /// A GUI sprite (`gui/sprites/...`, or a mod's `gui/...` texture)
        /// stretched over a rectangle, tinted 0xAARRGGBB.
        sprite(tuple<string, rect, u32>),
        /// An item, drawn as the hotbar draws it, at 16 x 16 times `scale`.
        /// The second string is an item model id to use instead (or empty).
        item(tuple<string, string, point, f32>),
        /// Text with a shadow, 0xRRGGBB; centred on `x` when the bool is set.
        text(tuple<string, point, u32, bool>),
    }
    /// Opens the mod's screen (or redraws it): coordinates are GUI pixels
    /// from the screen's centre, drawn in order.
    show: func(draws: list<draw>);
    close: func();
    /// The cursor in GUI pixels from the centre while the screen is open.
    cursor: func() -> option<point>;
}

/// Capability `render`: a post-processing pass the mod supplies, drawn over
/// the world (under the hand and the HUD) after the shader pack, if any.
interface render {
    /// The pass: a fragment shader in the shader-pack stage format
    /// (docs/shader-packs.md: the prelude's bindings and helpers, an
    /// `fs_main` entry). Compiled once per distinct source; an error is
    /// logged and the pass skipped.
    set-post: func(wgsl: string);
    /// Sixteen floats the pass reads as `frame.mod_params[0..4]`, kept until
    /// changed. The pass runs only while some are set.
    set-params: func(params: list<f32>);
    clear-post: func();
}

/// Capability `world`: the world around the player, and changes to it.
/// Changes need a world this game runs (single player, or hosting LAN);
/// on a remote server they are ignored and logged.
interface %world {
    record hit {
        /// The block hit and the point on its face.
        block-x: s32,
        block-y: s32,
        block-z: s32,
        x: f64,
        y: f64,
        z: f64,
        /// `minecraft:stone`, ...
        block: string,
    }
    /// The first block along the player's view (fluids pass), up to
    /// `distance` blocks (at most 512), as of this tick.
    raycast: func(distance: f32) -> option<hit>;
    /// Runs commands as the server would (operator level, no chat feedback),
    /// in order, right after this call returns, all in this tick.
    run-commands: func(commands: list<string>);
    /// A sound event (vanilla's or a resource pack's) at a point, or
    /// following the player when `at` is none.
    play-sound: func(event: string, at: option<tuple<f64, f64, f64>>, volume: f32, pitch: f32);
}

/// What the game calls. Only the hooks `init` asks for are ever called.
interface events {
    record registration {
        /// Chat commands, without the slash. A name vanilla already uses is
        /// refused (vanilla's command runs).
        commands: list<string>,
        /// Call `tick` every game tick (20 per second while playing).
        tick: bool,
        /// Call `frame` every rendered frame. Budget: 0.1 ms.
        frame: bool,
        /// Call `chat` for each chat line the player receives.
        chat: bool,
    }
    /// Once, after loading. An error keeps the mod off and is shown.
    init: func() -> result<registration, string>;
    tick: func(tick: u64);
    frame: func(seconds: f32);
    /// `/name args`: ok(some(text)) is shown as feedback, err(text) in red.
    command: func(name: string, args: string) -> result<option<string>, string>;
    chat: func(text: string);
}

world horizon-mod {
    import log;
    import game;
    import chat;
    import hud;
    import storage;
    import input;
    import ui;
    import render;
    import %world;
    export events;
}
